{
  "datasets": [
    {
      "name": "ds_period",
      "displayName": "KPIs por loja e período",
      "queryLines": [
        "WITH limits AS (\n  SELECT CAST(:period.min AS DATE) AS start_date,\n         CAST(:period.max AS DATE) AS end_date\n), scoped AS (\n  SELECT s.store_id, s.net_revenue, s.sale_count, s.item_count,\n         s.sale_date BETWEEN l.start_date AND l.end_date AS is_current\n  FROM workspace.mottainai_gold.sales_daily_kpis s\n  CROSS JOIN limits l\n  WHERE s.sale_date BETWEEN\n    date_sub(l.start_date, datediff(l.end_date, l.start_date) + 1)\n    AND l.end_date\n)\nSELECT store_id,\n       SUM(CASE WHEN is_current THEN net_revenue ELSE 0 END) AS revenue_brl,\n       SUM(CASE WHEN NOT is_current THEN net_revenue ELSE 0 END) AS previous_revenue_brl,\n       SUM(CASE WHEN is_current THEN sale_count ELSE 0 END) AS sales_count,\n       SUM(CASE WHEN NOT is_current THEN sale_count ELSE 0 END) AS previous_sales_count,\n       SUM(CASE WHEN is_current THEN item_count ELSE 0 END) AS items_count\nFROM scoped GROUP BY store_id"
      ],
      "parameters": [
        {
          "keyword": "period",
          "displayName": "Período das vendas",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_sales",
      "displayName": "Vendas diárias",
      "queryLines": [
        "SELECT sale_date, store_id, store_name, net_revenue AS revenue_brl,\n       sale_count, item_count\nFROM workspace.mottainai_gold.sales_daily_kpis"
      ]
    },
    {
      "name": "ds_tickets",
      "displayName": "Tickets concluídos",
      "queryLines": [
        "SELECT t.sale_date, t.store_id, s.store_name, t.ticket_amount, t.item_count\nFROM workspace.mottainai_gold.ticket_distribution t\nJOIN workspace.mottainai_gold.stores s ON s.store_id = t.store_id"
      ]
    },
    {
      "name": "ds_risk",
      "displayName": "Risco de estoque",
      "queryLines": [
        "SELECT store_id, store_name, product_id, product_name, consolidated_risk,\n       current_stock, days_of_coverage, value_at_expiration_risk\nFROM workspace.mottainai_gold.product_risk_ranking"
      ]
    },
    {
      "name": "ds_geo",
      "displayName": "Lojas geográficas",
      "queryLines": [
        "SELECT store_id, store_name, city, state_code, latitude, longitude\nFROM workspace.mottainai_gold.store_geography"
      ]
    },
    {
      "name": "ds_freshness",
      "displayName": "Frescor do lote",
      "queryLines": [
        "SELECT batch_id, source_cutoff_at, source_published_at, refreshed_at,\n       datediff(current_date(), CAST(source_cutoff_at AS DATE)) AS age_days\nFROM workspace.mottainai_gold.dashboard_freshness"
      ]
    }
  ],
