{
  "datasets": [
    {
      "name": "ds_period",
      "displayName": "KPIs de vendas por período",
      "queryLines": [
        "WITH limits AS (\n  SELECT CAST(:period.min AS DATE) AS start_date,\n         CAST(:period.max AS DATE) AS end_date\n), scoped AS (\n  SELECT s.store_id, s.net_revenue, s.sale_count, s.item_count,\n         s.sale_date BETWEEN l.start_date AND l.end_date AS is_current\n  FROM motta_analytics.gold.sales_daily s\n  CROSS JOIN limits l\n  WHERE s.sale_date BETWEEN\n    date_sub(l.start_date, datediff(l.end_date, l.start_date) + 1)\n    AND l.end_date\n)\nSELECT store_id,\n       SUM(CASE WHEN is_current THEN net_revenue ELSE 0 END) AS revenue_brl,\n       SUM(CASE WHEN NOT is_current THEN net_revenue ELSE 0 END) AS previous_revenue_brl,\n       SUM(CASE WHEN is_current THEN sale_count ELSE 0 END) AS sales_count,\n       SUM(CASE WHEN NOT is_current THEN sale_count ELSE 0 END) AS previous_sales_count,\n       SUM(CASE WHEN is_current THEN item_count ELSE 0 END) AS items_count\nFROM scoped GROUP BY store_id"
      ],
      "parameters": [
        {
          "keyword": "period",
          "displayName": "Período das vendas",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-30d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_sales",
      "displayName": "Vendas diárias",
      "queryLines": [
        "SELECT sale_date, company_id, store_id, store_name,\n       net_revenue AS revenue_brl, sale_count, item_count, average_ticket\nFROM motta_analytics.gold.sales_daily"
      ]
    },
    {
      "name": "ds_tickets",
      "displayName": "Tickets concluídos",
      "queryLines": [
        "SELECT sale_id, sale_date, store_id, store_name, ticket_amount, item_count\nFROM motta_analytics.gold.sales_tickets"
      ]
    },
    {
      "name": "ds_inventory",
      "displayName": "Saúde do estoque",
      "queryLines": [
        "SELECT snapshot_date, store_id, store_name, product_id, product_name,\n       on_hand_quantity, reserved_quantity, available_quantity, stock_value,\n       minimum_quantity, value_expiring_30d, expired_value, below_minimum, batch_count\nFROM motta_analytics.gold.inventory_health"
      ]
    },
    {
      "name": "ds_product",
      "displayName": "Vendas por produto",
      "queryLines": [
        "SELECT sale_date, store_id, store_name, product_id, product_name,\n       category_name, units_sold, net_revenue, sales_with_product\nFROM motta_analytics.gold.product_sales_daily"
      ]
    },
    {
      "name": "ds_batches",
      "displayName": "Lotes de estoque",
      "queryLines": [
        "SELECT snapshot_date, store_id, store_name, product_id, product_name,\n       source_batch_id, inventory_type, quantity, reserved_quantity,\n       available_quantity, stock_value, minimum_quantity, expiration_date, days_to_expiry\nFROM motta_analytics.gold.inventory_batches"
      ]
    },
    {
      "name": "ds_freshness",
      "displayName": "Frescor do lote",
      "queryLines": [
        "SELECT batch_id, model_version, source_cutoff_at, source_published_at, refreshed_at,\n       datediff(current_date(), CAST(source_cutoff_at AS DATE)) AS age_days\nFROM motta_analytics.gold.dashboard_freshness"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Qualidade Silver",
      "queryLines": [
        "SELECT relation_name, checked_rows, invalid_rows, checked_at\nFROM motta_analytics.gold.quality_summary"
      ]
    }
  ],
